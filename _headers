# Cloudflare Pages header rules.
#
# Code first, and deliberately: the host's default for js and css is
# max-age=14400, so a deployed fix can sit invisible for four hours while the
# browser serves the old file. There is no build step here and so no content
# hash in the filenames; revalidating is the only way to keep a page and its
# scripts in step.
#
# These rules match -- a marker header on the same rule came through -- but the
# Cache-Control is currently discarded, because the zone's Browser Cache TTL is
# set to 4 hours and acts as a floor: /resource/* raising the value to a week
# passes, lowering it to zero does not. Set Caching -> Configuration -> Browser
# Cache TTL to "Respect Existing Headers" in the Cloudflare dashboard and these
# take effect with no further change here.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/3d/js/*
  Cache-Control: public, max-age=0, must-revalidate

/3d/css/*
  Cache-Control: public, max-age=0, must-revalidate

# All matching rules are combined and duplicate headers are joined with a
# comma, so the patterns below are written not to overlap. In particular
# nothing here matches 3d/data/live/*.json or data/*.json: those are rewritten
# every 30 minutes and must keep the default revalidate-always behaviour.

# The catalogue binaries are 8-20 MiB each and only change when the archive is
# rebuilt offline. Without a long cache every cold edge pulls the whole file
# from the origin -- which is exactly what produced a 524 on the first request
# to a new region.
/3d/data/*.bin
  Cache-Control: public, max-age=604800

/3d/data/*.bin.part0
  Cache-Control: public, max-age=604800

/3d/data/*.bin.part1
  Cache-Control: public, max-age=604800

/3d/data/*.jpg
  Cache-Control: public, max-age=604800

/3d/data/*.png
  Cache-Control: public, max-age=604800

# Logo, banner and the social card: same file for the life of the design.
/resource/*
  Cache-Control: public, max-age=604800


# Local run artefacts -- regenerated on every cycle, never worth committing.
scripts/logs/
__pycache__/
*.pyc
*.log
node_modules/

# Archives over Cloudflare Pages' 25 MiB per-asset limit. What ships is the
# .part files scripts/split_bins.py writes beside them, listed in
# 3d/data/parts.json; the originals stay local as the thing to re-split when
# the earthquake-layer-3d pipeline rebuilds them.
3d/data/quakes.bin
3d/data/global/quakes-m3.bin

# R2 자격증명. 이 저장소는 공개이므로 절대 커밋되면 안 된다.
scripts/r2.json

# The delivered guide illustrations, 16 MB of PNG across eight files. What
# ships is resource/img/guide-*.webp -- the "without description" halves,
# resized and recompressed, with their labels reproduced as HTML in learn.html
# so they translate. The originals stay local as the thing to re-export from.
resource/img/*description).png
